<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into release builds made without dart-define ADS=on (see
     build.gradle.kts). The app_core package brings the Mobile Ads SDK; with
     ads off nothing may use the advertising ID or start the SDK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <application>
        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            android:authorities="${applicationId}.mobileadsinitprovider"
            tools:node="remove"/>
    </application>
</manifest>
